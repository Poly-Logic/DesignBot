@inherits LayoutComponentBase

<div class="app">
    <header class="app-header">
        <div class="brand">
            <Logo Size="30" Compact="true" />
            <div class="brand-text">
                <span class="logo">DESIGNBOT</span>
                <span class="logo-tag">AI DESIGN STUDIO</span>
            </div>
        </div>
    </header>
    <main>@Body</main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">Schließen</a>
</div>
