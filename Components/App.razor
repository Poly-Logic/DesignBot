<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="DesignBot.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <HeadOutlet />
</head>

<body>
    <canvas id="bg-canvas"></canvas>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.scrollChatToBottom = () => {
            const el = document.getElementById('chatMessages');
            if (el) el.scrollTop = el.scrollHeight;
        };

        (function () {
            const canvas = document.getElementById('bg-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w, h, points;
            const COUNT = 110, LINK = 150;
            const KINDS = [
                { fill: 'rgba(72, 190, 235, 0.55)', glow: 'rgba(72, 190, 235, 0.55)', blur: 6 },
                { fill: 'rgba(128, 91, 240, 0.52)', glow: 'rgba(128, 91, 240, 0.55)', blur: 7 },
                { fill: 'rgba(255, 255, 255, 0.95)', glow: 'rgba(255, 255, 255, 0.95)', blur: 12 }
            ];

            function resize() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            }
            function init() {
                points = [];
                for (let i = 0; i < COUNT; i++) {
                    const roll = Math.random();
                    points.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        vx: (Math.random() - 0.5) * 0.35,
                        vy: (Math.random() - 0.5) * 0.35,
                        r: 3 + Math.random() * 2,
                        kind: KINDS[roll < 0.6 ? 0 : roll < 0.8 ? 1 : 2]
                    });
                }
            }
            function step() {
                ctx.clearRect(0, 0, w, h);
                for (const p of points) {
                    p.x += p.vx; p.y += p.vy;
                    if (p.x < 0 || p.x > w) p.vx *= -1;
                    if (p.y < 0 || p.y > h) p.vy *= -1;
                }
                ctx.shadowBlur = 0;
                ctx.strokeStyle = 'rgba(108, 137, 200, 0.23)';
                ctx.lineWidth = 1;
                for (let i = 0; i < points.length; i++) {
                    for (let j = i + 1; j < points.length; j++) {
                        const a = points[i], b = points[j];
                        const dx = a.x - b.x, dy = a.y - b.y;
                        if (Math.sqrt(dx * dx + dy * dy) < LINK) {
                            ctx.beginPath();
                            ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
                        }
                    }
                }
                for (const p of points) {
                    ctx.fillStyle = p.kind.fill;
                    ctx.shadowColor = p.kind.glow;
                    ctx.shadowBlur = p.kind.blur;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fill();
                }
                requestAnimationFrame(step);
            }
            window.addEventListener('resize', () => { resize(); init(); });
            resize(); init(); step();
        })();
    </script>
</body>

</html>
